# ============================================================
# BenMMU probe — sdkconfig.defaults (ESP32-P4, chip rev v1.x)
# Matches the benlinux-standalone memory and protection setup so the
# probes see the same Core 1 PMP/PMA state Linux does.
# ============================================================

CONFIG_IDF_TARGET="esp32p4"

# Probes switch to a private trap stack and a U-mode stack.
CONFIG_ESP_SYSTEM_HW_STACK_GUARD=n

# Same PMP layout as BenLinux: no IRAM/DRAM split, PSRAM not covered by PMP.
CONFIG_ESP_SYSTEM_PMP_IDRAM_SPLIT=n

# Core 1 runs with interrupts off for the probe window.
CONFIG_ESP_INT_WDT_CHECK_CPU1=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# 64 KB external-memory MMU pages (BenMMU page size)
CONFIG_MMU_PAGE_SIZE_64KB=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
