--- a/components/esp_hw_support/port/esp32p4/cpu_region_protect.c
+++ b/components/esp_hw_support/port/esp32p4/cpu_region_protect.c
@@ -44,8 +44,20 @@
 
     // ROM uses some PMA entries, so we need to clear them before using them in ESP-IDF
 
-    // 0. Gap at bottom of address space
-    PMA_RESET_AND_ENTRY_SET_NAPOT(0, 0, SOC_CPU_SUBSYSTEM_LOW, PMA_NAPOT | PMA_NONE);
+    // 0. Gap at bottom of address space / CPU subsystem non-cacheable (Core 1)
+    if (esp_cpu_get_core_id() == 1) {
+        // Core 1 (BenOS Linux): mark CPU subsystem (CLIC, CLINT) as non-cacheable.
+        // Without this, the L1/L2 cache treats CLIC register reads as cacheable
+        // and returns stale kernel data instead of actual hardware values.
+        // The gap below CPU subsystem loses PMA protection but PMP default-deny
+        // still blocks invalid accesses. Safe because Linux doesn't access 0-0x1FFFFFFF.
+        const unsigned PMA_RW_NC = PMA_L | PMA_EN | PMA_R | PMA_W | PMA_NONCACHEABLE;
+        PMA_RESET_AND_ENTRY_SET_NAPOT(0, SOC_CPU_SUBSYSTEM_LOW,
+            SOC_CPU_SUBSYSTEM_HIGH - SOC_CPU_SUBSYSTEM_LOW, PMA_NAPOT | PMA_RW_NC);
+    } else {
+        // Core 0: original gap protection
+        PMA_RESET_AND_ENTRY_SET_NAPOT(0, 0, SOC_CPU_SUBSYSTEM_LOW, PMA_NAPOT | PMA_NONE);
+    }
 
     // 1. Gap between CPU subsystem region & HP TCM
     PMA_RESET_AND_ENTRY_SET_TOR(1, SOC_CPU_SUBSYSTEM_HIGH, PMA_NONE);
@@ -70,8 +82,16 @@
     PMA_RESET_AND_ENTRY_SET_TOR(10, SOC_IROM_MASK_HIGH, PMA_NONE);
     PMA_RESET_AND_ENTRY_SET_TOR(11, SOC_IRAM_LOW, PMA_TOR | PMA_NONE);
 
-    // 7. Gap between internal memory and HP peripherals
-    PMA_RESET_AND_ENTRY_SET_NAPOT(12, SOC_DRAM_HIGH, SOC_PERIPHERAL_LOW - SOC_DRAM_HIGH, PMA_NAPOT | PMA_NONE);
+    // 7. Gap between internal memory and HP peripherals / peripheral non-cacheable (Core 1)
+    if (esp_cpu_get_core_id() == 1) {
+        // Core 1: mark HP peripherals (systimer, intmtx) as non-cacheable.
+        // Gap protection lost but PMP default-deny blocks invalid accesses.
+        const unsigned PMA_RW_NC = PMA_L | PMA_EN | PMA_R | PMA_W | PMA_NONCACHEABLE;
+        PMA_RESET_AND_ENTRY_SET_NAPOT(12, SOC_PERIPHERAL_LOW,
+            SOC_PERIPHERAL_HIGH - SOC_PERIPHERAL_LOW, PMA_NAPOT | PMA_RW_NC);
+    } else {
+        PMA_RESET_AND_ENTRY_SET_NAPOT(12, SOC_DRAM_HIGH, SOC_PERIPHERAL_LOW - SOC_DRAM_HIGH, PMA_NAPOT | PMA_NONE);
+    }
 
     // 8. Special case - This whitelists the External flash/RAM, HP ROM and HP L2MEM regions and make them cacheable.
     // At the startup, this is done using PMA entry 15 by the ROM code.
